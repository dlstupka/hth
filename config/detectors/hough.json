{
  "schema_version": "0.1",
  "detector": "hough",
  "description": "Black-box calibration space for the OpenCV probabilistic Hough-lines document-envelope detector.",
  "profiles": {
    "baseline": {
      "canny_low_threshold": 40,
      "hough_threshold_fraction": 0.055,
      "minimum_length_fraction": 0.20,
      "maximum_gap_fraction": 0.055,
      "axis_angle_tolerance_degrees": 22.0,
      "outer_percentile": 10.0,
      "minimum_bbox_area_fraction": 0.10,
      "bbox_padding_fraction": 0.0
    }
  },
  "parameters": {
    "canny_low_threshold": {
      "type": "integer",
      "values": [25, 40, 65]
    },
    "hough_threshold_fraction": {
      "type": "float",
      "values": [0.035, 0.055, 0.08]
    },
    "minimum_length_fraction": {
      "type": "float",
      "values": [0.12, 0.20, 0.30]
    },
    "maximum_gap_fraction": {
      "type": "float",
      "values": [0.025, 0.055, 0.09]
    },
    "axis_angle_tolerance_degrees": {
      "type": "float",
      "values": [12.0, 22.0, 32.0]
    },
    "outer_percentile": {
      "type": "float",
      "values": [5.0, 10.0, 20.0]
    },
    "bbox_padding_fraction": {
      "type": "float",
      "values": [0.0, 0.005, 0.015]
    }
  },
  "binary_refine": {
    "passes": 3,
    "local_exhaustive_radius": 1
  },
  "regression": {
    "debug_artifacts": "failures"
  }
}
