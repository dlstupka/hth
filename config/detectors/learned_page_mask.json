{
  "schema_version": "0.1",
  "detector": "learned_page_mask",
  "description": "Calibration space for the model-backed HTH Learned Page-Mask detector.",
  "automatic": false,
  "runtime_requirements": {
    "model_env": "HTH_LEARNED_PAGE_MASK_MODEL",
    "model_format": "ONNX",
    "model_contract": "onnx-rgb-512-single-channel-mask-v1",
    "input": "1x3x512x512 float32 RGB in [0,1]",
    "output": "single foreground channel containing probabilities or logits"
  },
  "profiles": {
    "baseline": {
      "mask_threshold": 0.5,
      "minimum_mask_area_fraction": 0.15,
      "close_kernel_fraction": 0.006,
      "polygon_epsilon_fraction": 0.012,
      "bbox_padding_fraction": 0.0
    }
  },
  "parameters": {
    "mask_threshold": {
      "type": "float",
      "values": [
        0.35,
        0.5,
        0.65
      ]
    },
    "minimum_mask_area_fraction": {
      "type": "float",
      "values": [
        0.08,
        0.15,
        0.25
      ]
    },
    "close_kernel_fraction": {
      "type": "float",
      "values": [
        0.0,
        0.006,
        0.012
      ]
    },
    "polygon_epsilon_fraction": {
      "type": "float",
      "values": [
        0.005,
        0.012,
        0.025
      ]
    },
    "bbox_padding_fraction": {
      "type": "float",
      "values": [
        0.0,
        0.006,
        0.012
      ]
    }
  },
  "binary_refine": {
    "passes": 3,
    "local_exhaustive_radius": 1
  },
  "regression": {
    "debug_artifacts": "failures"
  }
}
