{
  "schema_version": "0.1",
  "detector": "learned_page_mask",
  "description": "Calibration space for PageNet-backed Learned Page-Mask.",
  "profiles": {
    "baseline": {
      "mask_threshold": 0.5,
      "minimum_mask_area_fraction": 0.15,
      "close_kernel_fraction": 0.006,
      "polygon_epsilon_fraction": 0.012,
      "bbox_padding_fraction": 0.0
    }
  },
  "parameters": {
    "mask_threshold": {
      "type": "float",
      "values": [
        0.35,
        0.5,
        0.65
      ]
    },
    "minimum_mask_area_fraction": {
      "type": "float",
      "values": [
        0.08,
        0.15,
        0.25
      ]
    },
    "close_kernel_fraction": {
      "type": "float",
      "values": [
        0.0,
        0.006,
        0.012
      ]
    },
    "polygon_epsilon_fraction": {
      "type": "float",
      "values": [
        0.005,
        0.012,
        0.025
      ]
    },
    "bbox_padding_fraction": {
      "type": "float",
      "values": [
        0.0,
        0.006,
        0.012
      ]
    }
  },
  "binary_refine": {
    "passes": 3,
    "local_exhaustive_radius": 1
  },
  "regression": {
    "debug_artifacts": "failures"
  },
  "lifecycle": {
    "prepare": "learned_page_mask",
    "model_policy": "reuse",
    "finalize": "learned_page_mask"
  },
  "model": {
    "family": "PageNet",
    "variant": "ohio",
    "training_domain": "Ohio Death Records",
    "source": "ctensmeyer/pagenet",
    "license": "BSD-3-Clause"
  }
}
