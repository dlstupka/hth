{
  "schema_version": "0.1",
  "detector": "learned_page_mask",
  "description": "Generation-2 calibration space for PageNet-backed Learned Page-Mask; 10,000 combinations focused around the first exhaustive calibration signal while retaining baseline and boundary probes.",
  "profiles": {
    "baseline": {
      "mask_threshold": 0.5,
      "minimum_mask_area_fraction": 0.15,
      "close_kernel_fraction": 0.006,
      "polygon_epsilon_fraction": 0.012,
      "bbox_padding_fraction": 0.0
    }
  },
  "parameters": {
    "mask_threshold": {
      "type": "float",
      "values": [
        0.2,
        0.25,
        0.3,
        0.325,
        0.35,
        0.375,
        0.4,
        0.45,
        0.5,
        0.6
      ]
    },
    "minimum_mask_area_fraction": {
      "type": "float",
      "values": [
        0.04,
        0.06,
        0.08,
        0.1,
        0.12,
        0.15,
        0.2,
        0.25
      ]
    },
    "close_kernel_fraction": {
      "type": "float",
      "values": [
        0.0,
        0.003,
        0.006,
        0.009,
        0.012
      ]
    },
    "polygon_epsilon_fraction": {
      "type": "float",
      "values": [
        0.003,
        0.005,
        0.008,
        0.012,
        0.018
      ]
    },
    "bbox_padding_fraction": {
      "type": "float",
      "values": [
        0.0,
        0.006,
        0.012,
        0.018,
        0.03
      ]
    }
  },
  "binary_refine": {
    "passes": 3,
    "local_exhaustive_radius": 1
  },
  "regression": {
    "debug_artifacts": "failures"
  },
  "lifecycle": {
    "prepare": "learned_page_mask",
    "model_policy": "reuse",
    "finalize": "learned_page_mask"
  },
  "model": {
    "family": "PageNet",
    "variant": "ohio",
    "training_domain": "Ohio Death Records",
    "source": "ctensmeyer/pagenet",
    "license": "BSD-3-Clause"
  },
  "optimizer_shape_compatibility": "detector-implementation"
}
