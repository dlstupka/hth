{
  "schema_version": "1.0",
  "default_target": "github-hosted",
  "targets": [
    {
      "id": "github-hosted",
      "description": "GitHub-hosted Ubuntu runner",
      "runs_on": ["ubuntu-latest"],
      "setup_label": "github-hosted"
    },
    {
      "id": "self-hosted-linux",
      "description": "Any Linux x64 self-hosted runner",
      "runs_on": ["self-hosted", "Linux", "X64"],
      "setup_label": "linux"
    },
    {
      "id": "self-hosted-windows",
      "description": "Any Windows x64 self-hosted runner",
      "runs_on": ["self-hosted", "Windows", "X64"],
      "setup_label": "windows"
    },
    {
      "id": "hth",
      "description": "HTH Linux x64 runner pool",
      "runs_on": ["self-hosted", "Linux", "X64", "hth"],
      "setup_label": "hth"
    },
    {
      "id": "rhel8",
      "description": "RHEL 8 Linux x64 runner pool",
      "runs_on": ["self-hosted", "Linux", "X64", "rhel8"],
      "setup_label": "rhel8"
    },
    {
      "id": "e7k",
      "description": "E7K Linux x64 runner pool",
      "runs_on": ["self-hosted", "Linux", "X64", "e7k"],
      "setup_label": "e7k"
    },
    {
      "id": "e9k",
      "description": "E9K Linux x64 runner pool",
      "runs_on": ["self-hosted", "Linux", "X64", "e9k"],
      "setup_label": "e9k"
    },
    {
      "id": "192vcpu",
      "description": "Linux x64 self-hosted runner with 192 vCPUs and a 384-thread policy budget",
      "runs_on": ["self-hosted", "Linux", "X64", "192vcpu"],
      "setup_label": "192vcpu",
      "aliases": ["192t"]
    },
    {
      "id": "96vcpu",
      "description": "Linux x64 self-hosted runner with 96 vCPUs and a 192-thread policy budget",
      "runs_on": ["self-hosted", "Linux", "X64", "96vcpu"],
      "setup_label": "96vcpu",
      "aliases": ["96t"]
    },
    {
      "id": "32vcpu",
      "description": "Linux x64 self-hosted runner with 32 vCPUs and a 64-thread policy budget",
      "runs_on": ["self-hosted", "Linux", "X64", "32vcpu"],
      "setup_label": "32vcpu",
      "aliases": ["32t"]
    }
  ]
}
